SECRET_KEY=your django secret key
DEBUG=True if you want to run the project in development mode
ALLOWED_HOSTS=127.0.0.1:8100,127.0.0.1,localhost:8100,localhost add your hosts here
WHITELISTED_HOSTS=http://127.0.0.1:8100,http://127.0.0.1,http://localhost:8100,http://localhost add your hosts here
BACKEND_PORT=8000 the port where the backend will run
FRONTEND_PORT=8100 the port where the frontend will run
NGROK_AUTH_TOKEN=your ngrok auth token
NGROK_SUBDOMAIN=your ngrok subdomain
